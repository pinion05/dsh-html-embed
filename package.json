{
  "name": "@local/html-embed",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Renders HTML code blocks from assistant messages as live sandboxed previews directly in the chat",
  "license": "MIT",
  "author": {
    "name": "pinion05",
    "url": "https://github.com/pinion05"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "html",
    "preview",
    "chat"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pinion05/dsh-html-embed.git"
  },
  "bugs": {
    "url": "https://github.com/pinion05/dsh-html-embed/issues"
  },
  "homepage": "https://github.com/pinion05/dsh-html-embed#readme",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-workspace-files"
      ]
    }
  }
}
